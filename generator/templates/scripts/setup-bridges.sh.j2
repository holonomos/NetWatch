#!/bin/bash
# NetWatch: Bridge Setup
# Generated from topology.yml: DO NOT HAND-EDIT
# 54 P2P fabric bridges + 1 management bridge.
# STP disabled on all fabric bridges (L3 routing, not L2 switching).
# Run as non-root; uses sudo internally for ip link commands.

set -euo pipefail

echo "NetWatch: Creating fabric bridges..."

# --- Management bridge ---
# Managed by libvirt ({{ mgmt_bridge }}); do NOT create or delete it here.
echo "  [mgmt] {{ mgmt_bridge }} (libvirt-managed, skipping creation)"

# --- Fabric bridges (STP disabled, no IP) ---
{% for link in links %}
echo "  [{{ link.tier }}] {{ link.bridge }} ({{ link.a_name }} <-> {{ link.b_name }})"
sudo ip link add {{ link.bridge }} type bridge 2>/dev/null || true
sudo bash -c 'echo 0 > /sys/class/net/{{ link.bridge }}/bridge/stp_state'
sudo ip link set {{ link.bridge }} up
{% endfor %}
{% if overlay_bridges %}

# --- EVPN overlay access bridges (one per tenant access segment, STP off) ---
# Each carries exactly two taps: server tnt0/tnt1 + leaf eth-ovl[-b]. No IP.
{% for ob in overlay_bridges %}
echo "  [overlay] {{ ob }} (tenant access segment)"
sudo ip link add {{ ob }} type bridge 2>/dev/null || true
sudo bash -c 'echo 0 > /sys/class/net/{{ ob }}/bridge/stp_state'
sudo ip link set {{ ob }} up
{% endfor %}
{% endif %}

echo ""
echo "NetWatch: {{ links|length }} fabric bridges{% if overlay_bridges %} + {{ overlay_bridges|length }} overlay bridges{% endif %} created (STP disabled)."
echo "  Mgmt bridge: {{ mgmt_bridge }} (libvirt-managed)."
