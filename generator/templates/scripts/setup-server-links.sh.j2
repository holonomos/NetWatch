#!/bin/bash
# NetWatch: Server & Bastion Fabric Wiring
# Generated from topology.yml: DO NOT HAND-EDIT
#
# Hot-plugs fabric NICs into server/bastion VMs, then configures IPs, ECMP
# routes, and NAT. Run as your user (uses sudo internally for virsh/bridges).

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
VIRSH_PREFIX="$(basename "$PROJECT_ROOT")"

echo "NetWatch: Wiring server and bastion VMs to fabric bridges..."

# Bounded wait for an attached NIC's MAC to appear in the domain's iface list.
wait_for_mac() {
    local domain="$1"
    local mac="$2"
    local tries=40           # 40 * 0.25s = 10s ceiling
    while [ "$tries" -gt 0 ]; do
        if virsh -c qemu:///system domiflist "$domain" 2>/dev/null </dev/null \
                | grep -qi "$mac"; then
            return 0
        fi
        sleep 0.25
        tries=$((tries - 1))
    done
    echo "    WARNING: MAC $mac did not surface on $domain within 10s"
    return 0
}

# Attach a NIC to a VM on a bridge (idempotent), then ensure its tap device
# is actually enslaved to that bridge.
attach_nic() {
    local vm="$1"
    local bridge="$2"
    local mac="$3"
    local domain="${VIRSH_PREFIX}_${vm}"

    if virsh -c qemu:///system domiflist "$domain" 2>/dev/null </dev/null | grep -qi "$mac"; then
        echo "    $bridge ($mac): already attached"
    else
        virsh -c qemu:///system attach-interface "$domain" \
            --type bridge \
            --source "$bridge" \
            --model virtio \
            --mac "$mac" \
            --live \
            --config </dev/null
        echo "    $bridge ($mac): attached"
        wait_for_mac "$domain" "$mac"
    fi

    # libvirt sometimes does not enslave the tap; force it.
    local vnet
    vnet=$(virsh -c qemu:///system domiflist "$domain" 2>/dev/null </dev/null | grep -i "$mac" | head -1 | awk '{print $1}')
    if [ -n "$vnet" ]; then
        local current_master
        current_master=$(ip link show "$vnet" 2>/dev/null | grep -oP 'master \K\S+' || true)
        if [ "$current_master" != "$bridge" ]; then
            sudo ip link set "$vnet" master "$bridge" 2>/dev/null \
                && echo "    $bridge ($mac): fixed bridge membership ($vnet)" \
                || true
        fi
    fi
}

# configure-vm-fabric.sh piped through vagrant ssh (avoids heredoc issues).
FABRIC_SCRIPT="$PROJECT_ROOT/scripts/fabric/configure-vm-fabric.sh"

configure_server() {
    local vm="$1"
    local mgmt_ip="$2"
    shift 2
    # remaining args: mac_a ip_a gw_a mac_b ip_b gw_b prefix [--no-default-route] [loopback]
    cd "$PROJECT_ROOT"
    # subshell isolates stdin from the parent script
    ( vagrant ssh "$vm" -c "sudo bash -s -- $*" < "$FABRIC_SCRIPT" )
}

# Accumulate per-node failures without aborting, so one flaky server does not
# block the bastion from being wired. Overall failure surfaced via exit code.
WIRE_RC=0

# --- Wire each server ---
{% for server in server_nodes %}
{% set if_a = server.interfaces[0] %}
{% set if_b = server.interfaces[1] %}
echo ""
echo "{{ server.name }}: {{ if_a.bridge }} ({{ if_a.peer }}) + {{ if_b.bridge }} ({{ if_b.peer }})"
attach_nic "{{ server.name }}" "{{ if_a.bridge }}" "{{ server.leaf_a_mac }}" || WIRE_RC=1
attach_nic "{{ server.name }}" "{{ if_b.bridge }}" "{{ server.leaf_b_mac }}" || WIRE_RC=1
configure_server "{{ server.name }}" "{{ server.mgmt_ip }}" \
    "{{ server.leaf_a_mac }}" "{{ if_a.ip }}" "{{ if_a.peer_ip }}" \
    "{{ server.leaf_b_mac }}" "{{ if_b.ip }}" "{{ if_b.peer_ip }}" \
    "{{ if_a.prefix_len }}" "{{ server.loopback.split('/')[0] if server.loopback else '' }}" || WIRE_RC=1
{% endfor %}

echo ""
echo "NetWatch: All 16 servers wired to fabric."
echo "  - 2 NICs per server (leaf-a + leaf-b)"
echo "  - ECMP default routes via fabric (north-south path active)"
{% if server_overlay_nics %}

# EVPN overlay access NICs on member servers (tnt0 / tnt1).
# One extra NIC per participating server on its per-tenant bridge (br-ovl-*).
# configure-overlay-if.sh gives it only the tenant /24 (no gateway, no routes)
# so it cannot perturb the /30 ECMP underlay. Does not touch the fabric NICs.
OVERLAY_IF_SCRIPT="$PROJECT_ROOT/scripts/fabric/configure-overlay-if.sh"
echo ""
echo "Attaching {{ server_overlay_nics|length }} EVPN overlay access NIC(s) to member servers..."
{% for so in server_overlay_nics %}
echo "  {{ so.server }}: {{ so.name }} on {{ so.bridge }} ({{ so.mac }}) -> {{ so.ip }}"
attach_nic "{{ so.server }}" "{{ so.bridge }}" "{{ so.mac }}"
( vagrant ssh "{{ so.server }}" -c "sudo bash -s -- {{ so.mac }} {{ so.ip }} {{ so.name }}" < "$OVERLAY_IF_SCRIPT" ) || WIRE_RC=1
{% endfor %}
echo ""
echo "NetWatch: {{ server_overlay_nics|length }} overlay access NIC(s) configured (tenant /24 only, no default/ECMP)."
{% endif %}

{% if bastion_node and bastion_node.interfaces|length >= 2 %}
# Bastion fabric wiring (north-south exit).
# Two NICs, one per border router; ECMP routes for fabric prefixes; NAT
# masquerade for fabric source IPs exiting to the internet.
echo ""
echo "========================================"
echo " Wiring bastion to fabric..."
echo "========================================"

{% set bst_if_a = bastion_node.interfaces[0] %}
{% set bst_if_b = bastion_node.interfaces[1] %}

# Deterministic MACs: 02:4E:57:05:01:01 (border-1), 02:4E:57:05:01:02 (border-2)
BASTION_MAC_A="02:4E:57:05:01:01"
BASTION_MAC_B="02:4E:57:05:01:02"

echo "bastion: {{ bst_if_a.bridge }} ({{ bst_if_a.peer }}) + {{ bst_if_b.bridge }} ({{ bst_if_b.peer }})"
attach_nic "bastion" "{{ bst_if_a.bridge }}" "$BASTION_MAC_A" || WIRE_RC=1
attach_nic "bastion" "{{ bst_if_b.bridge }}" "$BASTION_MAC_B" || WIRE_RC=1

# Configure bastion fabric interfaces + NAT.
BASTION_SCRIPT="$PROJECT_ROOT/scripts/fabric/configure-bastion-fabric.sh"
cd "$PROJECT_ROOT"
( vagrant ssh bastion -c "sudo bash -s -- 02:4E:57:05:01:01 {{ bst_if_a.ip }} {{ bst_if_a.peer_ip }} 02:4E:57:05:01:02 {{ bst_if_b.ip }} {{ bst_if_b.peer_ip }} {{ bst_if_a.prefix_len }}" < "$BASTION_SCRIPT" ) || WIRE_RC=1

echo ""
echo "NetWatch: Bastion wired to fabric."
echo "  - 2 NICs ({{ bst_if_a.peer }} + {{ bst_if_b.peer }})"
echo "  - ECMP routes for fabric prefixes"
echo "  - NAT masquerade for fabric source IPs"
{% endif %}

echo ""
echo "Verify:"
echo "  vagrant ssh srv-1-1 -c 'ip route show default'"
echo "  vagrant ssh bastion -c 'ip route show 10.0.0.0/8'"
echo "  vagrant ssh srv-1-1 -c 'traceroute -n 8.8.8.8'"

if [ "$WIRE_RC" -ne 0 ]; then
    echo "" >&2
    echo "WARNING: one or more nodes failed to wire (see WARN/error lines above)." >&2
    echo "The bastion was still configured; re-run 'make wire' to retry failed nodes." >&2
fi
exit $WIRE_RC
