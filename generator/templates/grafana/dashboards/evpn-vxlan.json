  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Remote MACs (over-VXLAN)",
      "description": "Sum of Type-2 (remote) MACs across all L2 VNIs; >0 confirms remote peers' MACs are learned via VXLAN.",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "0 — no remote MACs"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 16,
          "valueSize": 56
        },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "expr": "sum(netwatch_evpn_mac_remote_total) OR on() vector(0)",
          "instant": false,
          "legendFormat": "remote MACs",
          "range": true,
          "refId": "A"
        }
      ]
    },
