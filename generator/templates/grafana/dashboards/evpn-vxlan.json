      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "expr": "max by (vni, type, vrf) (netwatch_evpn_vni_info)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "vni": 0,
              "type": 1,
              "vrf": 2
            },
            "renameByName": {
              "vni": "VNI",
              "type": "Type",
              "vrf": "VRF"
            }
          }
        }
      ]
