    {
      "id": 10,
      "type": "logs",
      "title": "Recent error and down log lines",
      "description": "{job=~\".+\"} matching error, down, or fail (case-insensitive) across all log streams.",
      "datasource": {
        "type": "loki",
        "uid": "netwatch-loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "netwatch-loki"
          },
          "expr": "{job=~\".+\"} |~ \"(?i)error|down|fail\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
