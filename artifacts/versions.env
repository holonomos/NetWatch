# NetWatch — Pinned artifact versions
# All binary artifacts and their versions for reproducible builds.
# Sourced by scripts/artifacts/build.sh and scripts/bake-golden-image.sh.

# Host metrics exporter (installed on all VMs)
NODE_EXPORTER_VERSION="1.7.0"

# FRR routing suite (installed on 12 FRR switch VMs)
# Source: Fedora native repos (packages.fedoraproject.org/pkgs/frr/frr)
# Pin the package version for reproducible golden-image bakes. The bake does
# `dnf install frr-${FRR_VERSION}`; if that exact version is no longer in the
# Fedora repo it falls back to plain `dnf install frr` (logged as a warning).
# Leave empty (FRR_VERSION="") to always take the repo's current FRR.
FRR_VERSION="10.5.0"

# FRR metrics exporter (runs on FRR switch VMs)
# Repo: github.com/tynany/frr_exporter
FRR_EXPORTER_VERSION="1.10.1"

# Log pipeline (installed on obs VM)
PROMTAIL_VERSION="2.9.3"
LOKI_VERSION="2.9.3"

# Monitoring (installed on obs VM)
PROMETHEUS_VERSION="2.47.0"

# Dashboards (installed on obs VM)
GRAFANA_VERSION="10.0.3"
GRAFANA_RPM_RELEASE="1"

# Guest OS (VMs) — must match the vagrant box
FEDORA_RELEASE="44"
